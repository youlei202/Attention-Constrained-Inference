# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
ENV/

# IDE
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Large / generated data
data/*
!data/.gitkeep

# Results are generated; keep repo clean
result/*
!result/table/.gitkeep
!result/artifact/.gitkeep
!result/figure/.gitkeep
